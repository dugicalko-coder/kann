    },
    {
      "source": "/category/allgemein",
      "destination": "/bau",
      "permanent": true
    },
    {
      "source": "/category/bau",
      "destination": "/bau",
      "permanent": true
    },
    {
      "source": "/category/baurecht",
      "destination": "/bauordnung",
      "permanent": true
    },
    {
      "source": "/category/bautechnik",
      "destination": "/bau",
      "permanent": true
    },
    {
      "source": "/category/hausbau",
      "destination": "/haus-bauen",
      "permanent": true
    },
    {
      "source": "/category/innovation",
      "destination": "/bauwirtschaft",
      "permanent": true
    },
    {
      "source": "/category/nachhaltigkeit",
      "destination": "/sanierung",
      "permanent": true
    },
    {
      "source": "/category/news",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/category/wirtschaft",
      "destination": "/bauwirtschaft",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/page/:path*",
      "destination": "/news",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https:; frame-src https://maps.google.com https://www.google.com; connect-src 'self' https:; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "(www\\.)?baukurier\\.at"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}